+import { useState, FormEvent } from "react";
+import { api, apiErrorMessage } from "../../lib/api";
+import { useApplicantAuth } from "../../hooks/useApplicantAuth";
+
+export default function LoginPage() {
+  const { refreshMe } = useApplicantAuth();
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  async function handleSubmit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setSubmitting(true);
+    try {
+      await api.post("/applicant-auth/login", { email, password });
+      await refreshMe();
+    } catch (err) {
+      setError(apiErrorMessage(err, "Connexion impossible."));
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  return (
+    <div className="min-h-screen flex items-center justify-center bg-anac-gray">
+      <form onSubmit={handleSubmit} className="card w-full max-w-sm space-y-4">
+        <div>
+          <h1 className="text-anac-navy text-xl font-semibold">AIDN - Portail Postulant</h1>
+          <p className="text-anac-muted text-sm mt-1">
+            Organismes de Maintenance des Aeronefs - ANAC Gabon
+          </p>
+        </div>
+
+        {error && <p className="text-anac-danger text-sm">{error}</p>}
+
+        <div>
+          <label className="label">Email</label>
+          <input
+            type="email"
+            className="input"
+            value={email}
+            onChange={(e) => setEmail(e.target.value)}
+            required
+          />
+        </div>
+        <div>
+          <label className="label">Mot de passe</label>
+          <input
+            type="password"
+            className="input"
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            required
+          />
+        </div>
+
+        <button type="submit" className="btn-primary w-full" disabled={submitting}>
+          {submitting ? "Connexion..." : "Se connecter"}
+        </button>
+
+        <p className="text-anac-muted text-xs text-center">
+          Pas encore de compte ? La demande de creation de compte sera disponible prochainement.
+        </p>
+      </form>
+    </div>
+  );
+}
