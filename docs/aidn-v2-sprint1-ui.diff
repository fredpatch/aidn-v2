+import { useState, FormEvent } from "react";
+import { api, apiErrorMessage } from "../../lib/api";
+import { useAuth } from "../../hooks/useAuth";
+
+type Step = "credentials" | "set-password";
+type Mode = "password" | "otp";
+
+export default function LoginPage() {
+  const { refreshMe } = useAuth();
+  const [step, setStep] = useState<Step>("credentials");
+  const [mode, setMode] = useState<Mode>("password");
+  const [employeeCode, setEmployeeCode] = useState("");
+  const [password, setPassword] = useState("");
+  const [otp, setOtp] = useState("");
+  const [newPassword, setNewPassword] = useState("");
+  const [confirmation, setConfirmation] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  async function handleCredentialsSubmit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setSubmitting(true);
+    try {
+      const { data } = await api.post("/auth/login", {
+        employeeCode,
+        ...(mode === "password" ? { password } : { otp }),
+      });
+
+      if (data.firstLogin) {
+        setStep("set-password");
+      } else {
+        await refreshMe();
+      }
+    } catch (err) {
+      setError(apiErrorMessage(err, "Connexion impossible."));
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  async function handleSetPasswordSubmit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setSubmitting(true);
+    try {
+      await api.post("/auth/set-password", { password: newPassword, confirmation });
+      await refreshMe();
+    } catch (err) {
+      setError(apiErrorMessage(err, "Impossible de definir le mot de passe."));
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  if (step === "set-password") {
+    return (
+      <div className="min-h-screen flex items-center justify-center bg-anac-gray">
+        <form onSubmit={handleSetPasswordSubmit} className="card w-full max-w-sm space-y-4">
+          <div>
+            <h1 className="text-anac-navy text-xl font-semibold">Definir votre mot de passe</h1>
+            <p className="text-anac-muted text-sm mt-1">Code verifie. Choisissez votre mot de passe.</p>
+          </div>
+          {error && <p className="text-anac-danger text-sm">{error}</p>}
+          <div>
+            <label className="label">Nouveau mot de passe</label>
+            <input
+              type="password"
+              className="input"
+              value={newPassword}
+              onChange={(e) => setNewPassword(e.target.value)}
+              minLength={8}
+              required
+            />
+          </div>
+          <div>
+            <label className="label">Confirmation</label>
+            <input
+              type="password"
+              className="input"
+              value={confirmation}
+              onChange={(e) => setConfirmation(e.target.value)}
+              minLength={8}
+              required
+            />
+          </div>
+          <button type="submit" className="btn-primary w-full" disabled={submitting}>
+            {submitting ? "Enregistrement..." : "Enregistrer"}
+          </button>
+        </form>
+      </div>
+    );
+  }
+
+  return (
+    <div className="min-h-screen flex items-center justify-center bg-anac-gray">
+      <form onSubmit={handleCredentialsSubmit} className="card w-full max-w-sm space-y-4">
+        <div>
+          <h1 className="text-anac-navy text-xl font-semibold">AIDN - Connexion</h1>
+          <p className="text-anac-muted text-sm mt-1">Direction de la Navigabilite - ANAC Gabon</p>
+        </div>
+
+        {error && <p className="text-anac-danger text-sm">{error}</p>}
+
+        <div>
+          <label className="label">Matricule</label>
+          <input
+            className="input"
+            value={employeeCode}
+            onChange={(e) => setEmployeeCode(e.target.value)}
+            required
+          />
+        </div>
+
+        {mode === "password" ? (
+          <div>
+            <label className="label">Mot de passe</label>
+            <input
+              type="password"
+              className="input"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              required
+            />
+          </div>
+        ) : (
+          <div>
+            <label className="label">Code OTP (recu par email)</label>
+            <input className="input" value={otp} onChange={(e) => setOtp(e.target.value)} required />
+          </div>
+        )}
+
+        <button type="submit" className="btn-primary w-full" disabled={submitting}>
+          {submitting ? "Connexion..." : "Se connecter"}
+        </button>
+
+        <button
+          type="button"
+          className="text-anac-blue text-sm underline block mx-auto"
+          onClick={() => {
+            setMode(mode === "password" ? "otp" : "password");
+            setError(null);
+          }}
+        >
+          {mode === "password" ? "Premiere connexion ? Utiliser le code OTP" : "Utiliser mon mot de passe"}
+        </button>
+      </form>
+    </div>
+  );
+}
