PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# PORTAL_ORIGIN / ADMIN_ORIGIN identify which app sent a request (Origin, or
# Referer on same-origin GETs). authenticateEither and /api/files use them to
# pick the applicant (portal) or staff (admin) session - never the other one;
# with neither recognised and both sessions valid they answer 401
# AMBIGUOUS_SESSION. Must equal the browser origins exactly (no trailing slash):
# dev ports are admin 5173 and portal 5174 (Vite), proxied to the API on 4000.
PORTAL_ORIGIN=http://localhost:5174
ADMIN_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/aidn_v2
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Personnel ANAC - internal staff directory used for AIDN account creation
PERSONNEL_ANAC_BASE_URL=http://100.110.227.69:4005
PERSONNEL_ANAC_API_KEY=
# Set to false only for local/demo environments where the Personnel ANAC API is unavailable.
PERSONNEL_ANAC_ENFORCE=true

# Development-only destructive reset tools. Keep disabled by default.
ENABLE_DEV_RESET=false
# Extra safeguard: only set true for a disposable production-like environment.
ALLOW_PRODUCTION_DEV_RESET=false

# SMTP - env var names match SICOT so existing credentials can be reused as-is
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GEMINI_API_KEY=
# STORAGE-0A: signs 5-minute file links (distinct from JWT secrets). Optional
# locally (a temporary secret is generated); required in staging/production.
FILE_GRANT_SECRET=
